# Space Colony: Frontier - Backend Server Environment Template
# IMPORTANT: Use placeholder values only. Never commit real production secrets to version control.

PORT=3001
NODE_ENV=production

# Database Connection (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/space_colony_frontier?schema=public

# Server-Authoritative Inter-Service API Key
SERVER_API_KEY=your_secure_server_api_key_here

# Room Integrity & HMAC Validation Secret
ROOM_SECRET_KEY=your_secure_room_secret_key_here

# JWT Authentication & Session Signing Secret
JWT_SECRET=your_jwt_signing_secret_here
SESSION_SECRET=your_session_secret_here

# Admin Master Token for Telemetry & Diagnostics
ADMIN_TOKEN=your_admin_master_token_here

# Allowed Frontend Origins (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://space-colony-frontier.onrender.com
